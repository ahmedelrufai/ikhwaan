# Copy this file to .env.local and put real credentials there.
# Never add secrets to this example file.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional: without MongoDB, local development uses .data/portal.json
# This portal uses MONGODB_URI, not MONGODB_URL. Use a dedicated database/user.
MONGODB_URI=
MONGODB_DB=ikhwaan
# Initial connection deadlines; established connections are pooled.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_CONNECT_TIMEOUT_MS=10000
# Use a Paystack test secret for development; keep the value in .env.local.
PAYSTACK_SECRET_KEY=
# Enable only after fee, timing, and refund policy approval
PAYMENTS_APPROVED=false
MEMBERSHIP_FEE_KOBO=

# Optional Paystack webhook signing secret (whsec_); keep the value in .env.local.
PAYSTACK_WEBHOOK_SECRET=

# Email OTP sign-in and loan action emails: Gmail account and a Gmail app password (not the account password).
APP_URL=http://localhost:3000
EMAIL_USER=
EMAIL_PASSWORD=
# Optional friendly sender, e.g. Ikhwaan Cooperative <your-account@gmail.com>
LOAN_EMAIL_FROM=
# Random secret for the scheduled notification endpoint; required for HTTP workers.
LOAN_EMAIL_CRON_SECRET=
